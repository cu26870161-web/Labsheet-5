
#include <iostream>
using namespace std;

int main() {
    int n, original, temp, digits = 0, sum = 0;

    cout << "Enter a number: ";
    cin >> n;

    if (n < 0) {
        cout << "Not an Armstrong number";
        return 0;
    }

    original = n;
    temp = n;

    do {
        digits++;
        temp /= 10;
    } while (temp != 0);

    temp = n;

    do {
        int digit = temp % 10;
        int power = 1;

        for (int i = 0; i < digits; i++)
            power *= digit;

        sum += power;
        temp /= 10;
    } while (temp != 0);

    if (sum == original)
        cout << "Armstrong number";
    else
        cout << "Not an Armstrong number";

    return 0;
}
