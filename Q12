

#include <iostream>
using namespace std;

int main() {
    int n, count = 0;
    int first = 0, second = 1;

    cout << "Enter number of terms: ";
    cin >> n;

    while (count < n) {
        cout << first << " ";

        int next = first + second;
        first = second;
        second = next;

        count++;
    }

    return 0;
}

