
#include <iostream>
using namespace std;

int main() {
    for (int n = 1; n <= 500; n++) {
        int temp = n, sum = 0;

        do {
            int digit = temp % 10;
            sum += digit * digit * digit;
            temp /= 10;
        } while (temp != 0);

        if (sum == n)
            cout << n << " ";
    }

    return 0;
}
