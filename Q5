#include <iostream> 
using namespace std; 
int main() {
int a, b;
int choice;
cin >> a >> b >> choice;
switch (choice) {        
case 1:            cout << "Sum = " << a + b;            break;        
case 2:            cout << "Difference = " << a - b;            break;        
case 3:            cout << "Product = " << a * b;            break;        
case 4:            if (b != 0)                
cout << "Division = " << a / b;            
else                
cout << "Cannot divide by zero";            break;        
default:            cout << "Invalid choice";    }    return 0; }
