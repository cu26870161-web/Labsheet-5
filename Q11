
#include <iostream>
using namespace std;

int main() {
    int n, i = 1;
    int factorial = 1;

    cout << "Enter a number: ";
    cin >> n;

    if (n < 0 || n > 20) {
        cout << "Enter a number between 0 and 20";
        return 0;
    }

    while (i <= n) {
        factorial = factorial * i;
        i++;
    }

    cout << "Factorial = " << factorial;
    return 0;
}
