
#include <iostream>
using namespace std;

int main() {
    int a, b, remainder;

    cout << "Enter two numbers: ";
    cin >> a >> b;

    if (a < 0) a = -a;
    if (b < 0) b = -b;

    while (b != 0) {
        remainder = a % b;
        a = b;
        b = remainder;
    }

    cout << "GCD = " << a;

    return 0;
}
