
#include <iostream>
using namespace std;

int main() {
    int n, original, reverse = 0;

    cout << "Enter a number: ";
    cin >> n;

    if (n < 0) {
        cout << "Negative numbers are not palindromes";
        return 0;
    }

    original = n;

    while (n > 0) {
        int digit = n % 10;
        reverse = reverse * 10 + digit;
        n /= 10;
    }

    cout << "Reverse = " << reverse << endl;

    if (original == reverse)
        cout << "Palindrome number";
    else
        cout << "Not a palindrome number";

    return 0;
}
